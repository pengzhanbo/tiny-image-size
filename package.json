{
  "name": "tiny-image-size",
  "version": "1.0.0",
  "description": "get dimensions of image file (jpeg, png, webp, svg, tiff, etc)",
  "keywords": [
    "avif",
    "bmp",
    "cur",
    "dimensions",
    "gif",
    "heic",
    "heif",
    "height",
    "icns",
    "ico",
    "image",
    "jpeg",
    "jxl",
    "png",
    "psd",
    "resolution",
    "size",
    "svg",
    "tga",
    "tiff",
    "webp",
    "width"
  ],
  "homepage": "https://github.com/pengzhanbo/tiny-image-size",
  "bugs": "https://github.com/pengzhanbo/tiny-image-size/issues",
  "license": "MIT",
  "author": "pengzhanbo <q942450674@outlook.com> (https://github.com/pengzhanbo)",
  "repository": {
    "type": "git",
    "url": "https://github.com/pengzhanbo/tiny-image-size.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "build": "tsdown",
    "lint": "oxlint . --type-check --type-aware && oxfmt . --check",
    "lint:action": "oxlint . --type-check --type-aware --format=github && oxfmt . --check",
    "format": "oxlint . --type-check --type-aware --fix && oxfmt .",
    "prepublishOnly": "pnpm run build",
    "release:publish": "pnpm publish --provenance --access public",
    "release": "bumpp package.json --commit \"build: publish v%s\" --push --tag --all",
    "test": "vitest --coverage"
  },
  "devDependencies": {
    "@pengzhanbo/oxc-config": "^2.9.0",
    "@pengzhanbo/tsconfig": "^2.9.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "bumpp": "^12.2.1",
    "js-tokens": "^10.0.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.13.1",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "./node_modules/.bin/nano-staged --allow-empty"
  },
  "nano-staged": {
    "*.{js,ts,mjs,cjs}": "pnpm run lint",
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts}": "vitest related --run"
  },
  "packageManager": "pnpm@11.22.0"
}
